+++ b/paul_resume_state.py
@@ -0,0 +1,63 @@
+"""RNG and GradScaler state in checkpoints, restored on --resume (patch P6).
+
+Every checkpoint gets ``paul_rng_states`` (one entry per DDP rank: Python, NumPy, torch CPU
+and current-device CUDA generator states) and ``paul_grad_scaler``. All values are plain
+ints/floats/lists/tensors so runx's ``weights_only`` checkpoint reload still works. A
+resumed run then continues the same random stream on every rank (cuDNN kernels remain
+non-deterministic, so the trajectory is still not bit-exact).
+"""
+import random
+
+import numpy as np
+import torch
+
+
+def capture():
+    version, internal, gauss = random.getstate()
+    name, keys, pos, has_gauss, cached = np.random.get_state()
+    return {
+        'python': {'version': int(version), 'state': [int(x) for x in internal],
+                   'gauss': None if gauss is None else float(gauss)},
+        'numpy': {'name': str(name), 'keys': torch.from_numpy(keys.astype(np.int64)),
+                  'pos': int(pos), 'has_gauss': int(has_gauss), 'cached': float(cached)},
+        'torch': torch.get_rng_state(),
+        'cuda': torch.cuda.get_rng_state() if torch.cuda.is_initialized() else None,
+    }
+
+
+def apply(state):
+    python = state['python']
+    random.setstate((python['version'], tuple(python['state']), python['gauss']))
+    numpy_state = state['numpy']
+    np.random.set_state((numpy_state['name'], numpy_state['keys'].numpy().astype(np.uint32),
+                         numpy_state['pos'], numpy_state['has_gauss'], numpy_state['cached']))
+    torch.set_rng_state(state['torch'])
+    if state['cuda'] is not None:
+        torch.cuda.set_rng_state(state['cuda'])
+
+
+def gather():
+    """Collective under DDP: every rank must call it. Returns the list of rank states."""
+    state = capture()
+    if torch.distributed.is_available() and torch.distributed.is_initialized():
+        states = [None] * torch.distributed.get_world_size()
+        torch.distributed.all_gather_object(states, state)
+        return states
+    return [state]
+
+
+def restore(checkpoint, rank, world_size, scaler, log=print):
+    states = checkpoint.get('paul_rng_states')
+    if states is None:
+        log('P6: checkpoint has no RNG state (pre-P6 checkpoint); RNG streams restart')
+    elif len(states) != world_size:
+        raise RuntimeError(f'P6: checkpoint has RNG state for {len(states)} ranks, '
+                           f'resuming with {world_size}')
+    else:
+        apply(states[rank])
+    scaler_state = checkpoint.get('paul_grad_scaler')
+    if scaler_state is None:
+        log('P6: checkpoint has no GradScaler state; scaler restarts')
+    else:
+        scaler.load_state_dict(scaler_state)
+    return states is not None and scaler_state is not None
