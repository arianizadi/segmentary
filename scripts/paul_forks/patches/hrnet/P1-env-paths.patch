diff --git a/paul_env.py b/paul_env.py
new file mode 100644
index 0000000..65758a6
--- /dev/null
+++ b/paul_env.py
@@ -0,0 +1,33 @@
+"""Fail-closed data and weight paths for the RAD 9/24 fork runs (patch P1).
+
+Every path that used to be hardcoded in this fork (Paul's /home/stanik paths, or the
+September 2026 RTIS v2 adapter) is read from an environment variable instead. An unset,
+relative or missing value raises, so a run can never fall back to a stale dataset or a
+stale centroid cache.
+
+    PAUL_ADAPTER_ROOT          RAD arm adapter (trainVal_/val_/test_ images+masks, classes.json)
+    PAUL_RS19_ROOT             RailSem19 split (train_/trainVal_/val_/test_ images+masks,
+                               rs19-config.json)
+    PAUL_CENTROID_ROOT         per-run class-uniform centroid cache directory (must exist)
+    PAUL_HRNET_IMAGENET_CKPT   HRNet-W48 ImageNet backbone loaded when the model is built
+"""
+import os
+
+
+def _require(name, check, kind):
+    value = os.environ.get(name, '')
+    if not value:
+        raise RuntimeError(f'{name} is not set; refusing to use a hardcoded {kind}')
+    if not os.path.isabs(value):
+        raise RuntimeError(f'{name} must be an absolute path, got {value!r}')
+    if not check(value):
+        raise RuntimeError(f'{name}={value} is not an existing {kind}')
+    return value
+
+
+def require_dir(name):
+    return _require(name, os.path.isdir, 'directory')
+
+
+def require_file(name):
+    return _require(name, os.path.isfile, 'file')
