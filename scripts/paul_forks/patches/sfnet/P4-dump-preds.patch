+def dump_predictions(val_loader, net, args):
+    """P4: whole-image single-scale inference, one uint8 PNG per image."""
+    import paul_dump
+    if args.local_rank == 0:
+        paul_dump.prepare(args.dump_preds)
+    if args.apex:
+        torch.distributed.barrier()
+    net.eval()
+    for inputs, gt_image, img_names in val_loader:
+        with torch.no_grad():
+            output = net(inputs.cuda())
+        assert output.size()[2:] == gt_image.size()[1:]
+        assert output.size()[1] == args.dataset_cls.num_classes
+        predictions = output.data.max(1)[1].cpu().numpy()
+        paul_dump.write(args.dump_preds, list(img_names), predictions,
+                        args.dataset_cls.num_classes)
+    if args.apex:
+        torch.distributed.barrier()
+    if args.local_rank == 0:
+        names = [os.path.splitext(os.path.basename(item[0]))[0]
+                 for item in val_loader.dataset.imgs]
+        manifest = paul_dump.finalize(args.dump_preds, names, {
+            'fork': 'sfnet', 'split': args.dump_split, 'dataset': args.dataset,
+            'snapshot': args.snapshot, 'arch': args.arch,
+            'single_scale_whole_image': True,
+            'num_classes': args.dataset_cls.num_classes})
+        print('P4: dumped {} predictions to {}'.format(manifest['count'], args.dump_preds))
+
