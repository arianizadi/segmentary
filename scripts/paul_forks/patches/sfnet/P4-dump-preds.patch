+"""Eval-only prediction dump for Segmentary scoring (patch P4).
+
+Writes one uint8 label PNG per evaluated image to ``<dir>/<image stem>.png``. The stem is
+the adapter file name (``<group>__<stem>``), so predictions pair 1:1 with the adapter's
+``<split>_masks/<group>__<stem>.png``. The directory must not exist beforehand, files are
+never overwritten, and ``<dir>.manifest.json`` (next to the directory, so the directory
+holds nothing but the PNGs) is written only after checking that exactly the expected set
+of images was dumped (each DDP rank writes its own share).
+"""
+import hashlib
+import json
+import os
+
+import numpy as np
+from PIL import Image
+
+MANIFEST_SUFFIX = '.manifest.json'
+
+
+def manifest_path(out_dir):
+    return os.path.normpath(out_dir) + MANIFEST_SUFFIX
+
+
+def prepare(out_dir):
+    if os.path.lexists(out_dir) or os.path.lexists(manifest_path(out_dir)):
+        raise RuntimeError(f'P4: dump directory already exists, refusing to mix runs: {out_dir}')
+    os.makedirs(out_dir)
+
+
+def write(out_dir, names, predictions, num_classes):
+    predictions = np.asarray(predictions)
+    if predictions.ndim != 3 or len(names) != predictions.shape[0]:
+        raise RuntimeError(f'P4: expected (N,H,W) predictions for {len(names)} names, '
+                           f'got {predictions.shape}')
+    for name, pred in zip(names, predictions):
+        if pred.min() < 0 or pred.max() >= num_classes or num_classes > 255:
+            raise RuntimeError(f'P4: prediction for {name} outside [0, {num_classes})')
+        path = os.path.join(out_dir, f'{name}.png')
+        if os.path.lexists(path):
+            raise RuntimeError(f'P4: duplicate prediction for {name}')
+        Image.fromarray(np.ascontiguousarray(pred, dtype=np.uint8)).save(path)
+
+
+def _sha256(path):
+    digest = hashlib.sha256()
+    with open(path, 'rb') as stream:
+        for block in iter(lambda: stream.read(1 << 20), b''):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def finalize(out_dir, expected_names, meta):
+    expected = sorted(expected_names)
+    files = os.listdir(out_dir)
+    found = sorted(f[:-4] for f in files if f.endswith('.png'))
+    if len(found) != len(files):
+        raise RuntimeError(f'P4: non-PNG files in {out_dir}: '
+                           f'{sorted(f for f in files if not f.endswith(".png"))[:5]}')
+    if found != expected or len(set(expected)) != len(expected):
+        missing = sorted(set(expected) - set(found))
+        extra = sorted(set(found) - set(expected))
+        raise RuntimeError(f'P4: dump incomplete: missing {missing[:5]} extra {extra[:5]} '
+                           f'({len(found)} of {len(expected)})')
+    manifest = dict(meta)
+    manifest['count'] = len(found)
+    manifest['images'] = found
+    snapshot = manifest.get('snapshot')
+    if snapshot and os.path.isfile(snapshot):
+        manifest['snapshot_sha256'] = _sha256(snapshot)
+    with open(manifest_path(out_dir), 'w') as stream:
+        json.dump(manifest, stream, indent=2)
+    return manifest
