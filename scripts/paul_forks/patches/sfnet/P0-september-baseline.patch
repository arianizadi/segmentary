--- /dev/null
+++ b/compat_native_amp.py
@@ -0,0 +1,33 @@
+"""Native PyTorch replacement for the narrow legacy Apex AMP calls used here."""
+from contextlib import contextmanager
+from functools import wraps
+import torch
+scaler = torch.amp.GradScaler("cuda")
+class NativeAMP:
+    @staticmethod
+    def float_function(function):
+        @wraps(function)
+        def inner(*args, **kwargs):
+            with torch.autocast("cuda", enabled=False):
+                args = tuple(x.float() if isinstance(x, torch.Tensor) and x.is_floating_point() else x for x in args)
+                return function(*args, **kwargs)
+        return inner
+    @staticmethod
+    def disable_casts():
+        return torch.autocast("cuda", enabled=False)
+    @staticmethod
+    def initialize(net, optim, opt_level="O1"):
+        if opt_level != "O1":
+            raise ValueError("Only native AMP equivalent of O1 is supported")
+        original = net.forward
+        @wraps(original)
+        def forward(*args, **kwargs):
+            with torch.autocast("cuda", dtype=torch.float16):
+                return original(*args, **kwargs)
+        net.forward = forward
+        return net, optim
+    @staticmethod
+    @contextmanager
+    def scale_loss(loss, optim):
+        yield scaler.scale(loss)
+amp = NativeAMP()
